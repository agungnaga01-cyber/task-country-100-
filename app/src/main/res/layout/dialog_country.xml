<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="22dp"
    android:background="@drawable/bg_dialog">

    <ImageView
        android:id="@+id/dialogFlag"
        android:layout_width="130dp"
        android:layout_height="82dp"
        android:contentDescription="Bendera negara"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/dialogCountryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Nama Negara"
        android:textColor="#21163D"
        android:textSize="23sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_iso_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="ISO 2"
                android:textColor="#625780"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dialogIso2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AF"
                android:textColor="#21163D"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="ISO 3"
                android:textColor="#625780"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dialogIso3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AFG"
                android:textColor="#21163D"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFavoriteAction"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:text="♡ Tambah Favorit"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#6841D9"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="Tutup"
        android:textColor="#6841D9"
        android:textSize="16sp"
        app:backgroundTint="#EFE8FF"
        app:cornerRadius="16dp" />

</LinearLayout>
